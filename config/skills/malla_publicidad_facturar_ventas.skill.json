{
  "schema_version": 1,
  "id": "malla_publicidad_facturar_ventas",
  "label": "Facturar ventas Malla Publicidad",
  "description": "Registra facturas de venta de Malla Publicidad con «Esperar Orden Cliente» = No. Fecha registro: del 1 del mes hasta hoy (cambiar a current_month en el editor si debe ir hasta fin de mes). Informe: nº documento y nº contrato. Ajuste esperarOrdenCliente/contractNo si OData usa otros nombres.",
  "spec": {
    "company": "Malla Publicidad",
    "type_id": "sales_invoice",
    "action_id": "registrar_factura",
    "date_filter": {
      "field": "posting_date",
      "dynamic": "month_to_today"
    },
    "extra_odata_filters": {
      "esperarOrdenCliente": false
    },
    "limit": 500,
    "dry_run": true,
    "on_error": "report_and_continue",
    "before_action_field_edits": [
      {
        "field_label": "Fecha registro",
        "value": "today"
      }
    ]
  },
  "report": {
    "fields": [
      {
        "key": "number",
        "label": "Nº documento",
        "odata": "number"
      },
      {
        "key": "contract",
        "label": "Nº contrato",
        "odata": "contractNo"
      }
    ],
    "notify_emails": [
      "andreuserra@malla.es",
      "mauel@malla.es",
      "julian@malla.es"
    ]
  }
}
