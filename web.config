<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>

    <handlers>
      <add name="httpPlatformHandler"
           path="*"
           verb="*"
           modules="httpPlatformHandler"
           resourceType="Unspecified" />
    </handlers>

    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="104857600" />
      </requestFiltering>
    </security>

    <!--
      Ajusta processPath si el Python de IIS no es C:\Python\python.exe
      Ajusta AGENTEBC_RELEASES_DIR a la carpeta con latest.json y el .exe
    -->
    <httpPlatform
        processPath="C:\Python\python.exe"
        arguments="wsgi.py"
        stdoutLogEnabled="true"
        stdoutLogFile=".\logs\agentebc-stdout.log"
        startupTimeLimit="120"
        requestTimeout="00:05:00">

      <environmentVariables>
        <environmentVariable name="HTTP_PLATFORM_PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="AGENTEBC_RELEASES_DIR" value="C:\inetpub\wwwroot\AgenteBc\data\releases" />
        <environmentVariable name="AGENTEBC_ACTIONS_DIR" value="C:\inetpub\wwwroot\AgenteBc\data\actions" />
        <environmentVariable name="AGENTEBC_WORKER_SKILLS_SHARE_DIR" value="C:\inetpub\wwwroot\AgenteBc\data\skills-share" />
        <!-- Mismo valor que AGENTEBC_SHARE_TOKEN en el .env del consultor / publish_skill.py -->
        <!-- <environmentVariable name="AGENTEBC_SHARE_TOKEN" value="..." /> -->
      </environmentVariables>

    </httpPlatform>

  </system.webServer>
</configuration>
