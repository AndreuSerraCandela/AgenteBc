# Copiar como .env. No incluir credenciales reales en este fichero.
AGENTEBC_ODATA_BASE_URL=https://servidor/instancia/ODataV4
AGENTEBC_AUTH_MODE=basic
AGENTEBC_USERNAME=
AGENTEBC_PASSWORD=
AGENTEBC_COMPANY=Nombre de la empresa
AGENTEBC_LICENSE_TOKEN=
AGENTEBC_LICENSE_URL=
AGENTEBC_LICENSE_CLIENT=
AGENTEBC_SOURCE_PATH=C:\Ruta\A\Fuentes\BC
AGENTEBC_ALPACKAGES_PATH=C:\Ruta\A\Fuentes\BC\Funciones\.alpackages
# Alternativa remota al código local (objetos-bc-agent en el PC con BC_ROOT)
AGENTEBC_BC_AGENT_URL=http://192.168.10.238:5051
AGENT_TOKEN=a
AGENTEBC_SQL_ENV_FILE=C:\Ruta\A\db.local.env
AGENTEBC_TLS_VERIFY=true
AGENTEBC_REQUEST_TIMEOUT=30
AGENTEBC_BROWSER_HEADLESS=false
AGENTEBC_LM_STUDIO_URL=http://192.168.10.238:1234/v1
AGENTEBC_LM_STUDIO_MODEL=qwen2.5-32b-instruct
