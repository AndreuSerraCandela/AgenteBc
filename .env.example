# Copiar como .env. No incluir credenciales reales en este fichero.
AGENTEBC_ODATA_BASE_URL=
# Cliente web BC (Playwright). Opcional: si se omite, se deduce quitando /ODataV4 de OData
# AGENTEBC_WEB_BASE_URL=http://localhost:8080/BC270
# AGENTEBC_WEB_COMPANY_USE_GUID=false
# basic = usuario/contraseña en .env; windows = OData con SSO Windows (sin user/pass en fichero)
AGENTEBC_AUTH_MODE=basic
AGENTEBC_USERNAME=
AGENTEBC_PASSWORD=
# Web BC sin guardar contraseña: perfil Edge/Chrome + login interactivo la primera vez
# AGENTEBC_WEB_USE_WINDOWS_SESSION=true
# AGENTEBC_BROWSER_CHANNEL=msedge
# AGENTEBC_WEB_BROWSER_PROFILE=
# Buzón de skills compartidos (consultor → usuario): carpeta de red o local
# AGENTEBC_WORKER_SKILLS_SHARE_DIR=C:\datos\AgenteBc\skills-share
AGENTEBC_COMPANY=
AGENTEBC_LICENSE_TOKEN=
AGENTEBC_LICENSE_URL=
AGENTEBC_LICENSE_CLIENT=
AGENTEBC_SOURCE_PATH=
AGENTEBC_ALPACKAGES_PATH=
# Alternativa remota al código local (objetos-bc-agent en el PC con BC_ROOT)
AGENTEBC_BC_AGENT_URL=
AGENTEBC_BC_AGENT_TOKEN=
AGENTEBC_SQL_ENV_FILE=
AGENTEBC_TLS_VERIFY=true
AGENTEBC_REQUEST_TIMEOUT=30
# Tras pulsar Registrar (etc.): máximo de espera por factura antes de pasar a la siguiente
AGENTEBC_WEB_ACTION_IDLE_TIMEOUT=60
# Reintentos de la misma factura si BC queda colgado (sin error claro ni registro)
AGENTEBC_WEB_ACTION_MAX_ATTEMPTS=3
AGENTEBC_BROWSER_HEADLESS=false
# Navegador para Playwright: chrome, msedge o chromium
AGENTEBC_BROWSER_CHANNEL=
# Proveedor de conclusiones IA: lm_studio, deepseek, deepseek_web o google_ai_web
AGENTEBC_AI_PROVIDER=
AGENTEBC_LM_STUDIO_URL=
AGENTEBC_LM_STUDIO_MODEL=
# IA solo para informes del worker (resumen tras lote). Puede ser LM Studio aunque
# AGENTEBC_AI_PROVIDER sea deepseek_web en el consultor.
# AGENTEBC_WORKER_AI_PROVIDER=lm_studio
# AGENTEBC_WORKER_LM_STUDIO_URL=http://127.0.0.1:1234/v1
# AGENTEBC_WORKER_LM_STUDIO_MODEL=
# Alternativa en la nube (API compatible con OpenAI)
# AGENTEBC_AI_PROVIDER=deepseek
# AGENTEBC_DEEPSEEK_API_KEY=
# AGENTEBC_DEEPSEEK_MODEL=deepseek-chat
# AGENTEBC_DEEPSEEK_URL=https://api.deepseek.com
# Alternativa por navegador (sin API key; requiere login manual la 1ª vez)
# AGENTEBC_AI_PROVIDER=deepseek_web
# AGENTEBC_DEEPSEEK_WEB_URL=https://chat.deepseek.com
# Opcional. Si se omite, usa %USERPROFILE%\.agentebc\deepseek-profile
# AGENTEBC_DEEPSEEK_WEB_PROFILE=C:\Users\Andres\.agentebc\deepseek-profile
# AGENTEBC_DEEPSEEK_WEB_TIMEOUT=90
# Tiempo para iniciar sesión manualmente la primera vez (segundos)
# AGENTEBC_DEEPSEEK_WEB_LOGIN_TIMEOUT=120
# Recomendado si DeepSeek bloquea el login automatizado: conectar a Chrome real
# AGENTEBC_DEEPSEEK_WEB_CDP_URL=http://127.0.0.1:9222
# URL CDP unificada para proveedores web (DeepSeek, Google Modo IA).
# Si Chrome no está en marcha con depuración, AgenteBc lo abre automáticamente
# (sin cerrar otras ventanas de Chrome) para que hagas login manual la 1ª vez.
# AGENTEBC_AI_WEB_CDP_URL=http://127.0.0.1:9222
# Alternativa por navegador: Google Modo IA (mismo Chrome con depuración)
# AGENTEBC_AI_PROVIDER=google_ai_web
# AGENTEBC_GOOGLE_AI_WEB_URL=https://www.google.com/ai
# AGENTEBC_BROWSER_HEADLESS=false
# Informes del worker (correo tras lote con skill)
# Reutilizar MAIL_* de otra app (p. ej. Control de Presencia):
# AGENTEBC_SMTP_ENV_FILE=C:\Users\Andres\Source\Python\ControldePresencia\.env
# AGENTEBC_SMTP_HOST=smtp.office365.com
# AGENTEBC_SMTP_PORT=587
# AGENTEBC_SMTP_USER=
# AGENTEBC_SMTP_PASSWORD=
# AGENTEBC_SMTP_FROM=
# AGENTEBC_SMTP_TLS=true

# Compartir acciones entre consultores (mismo token en todos los PCs)
# El mismo token autentica POST /api/releases/upload del instalador
AGENTEBC_SHARE_URL=https://agentebc.malla.es
AGENTEBC_SHARE_TOKEN=
AGENTEBC_SHARE_USER=
