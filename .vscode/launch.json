{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Agente BC Web",
      "type": "debugpy",
      "request": "launch",
      "module": "agentebc.webapp",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Flask (wsgi)",
      "type": "debugpy",
      "request": "launch",
      "module": "flask",
      "args": [
        "--app",
        "wsgi:app",
        "run",
        "--debug",
        "--reload"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "FLASK_APP": "wsgi:app",
        "FLASK_DEBUG": "1"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
